{
    "name": "linked-analytics-app",
    "version": "0.0.1",
    "description": "View DHIS2 Maps, Data Visualizer and other analytics plugins side by side in a flexible grid, and link them so selections in one update the others.",
    "license": "BSD-3-Clause",
    "private": true,
    "engines": {
        "node": ">=22.22.2"
    },
    "scripts": {
        "build": "d2-app-scripts build",
        "start": "d2-app-scripts start",
        "test": "vitest run",
        "test:watch": "vitest",
        "deploy": "d2-app-scripts deploy",
        "lint": "./scripts/lint.sh",
        "format": "./scripts/format.sh",
        "generate-types": "./scripts/generate-types.sh",
        "postinstall": "./scripts/postinstall.sh"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@dhis2/app-service-data": "^3.17.4",
        "@dhis2/cli-app-scripts": "^12.11.5",
        "@dhis2/config-eslint": "^0.2.2",
        "@dhis2/config-prettier": "^0.4.0",
        "@eslint/compat": "^2.1.1",
        "@ls-lint/ls-lint": "^2.3.1",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.5.1",
        "@types/react": "^18.3.23",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.1.0",
        "eslint": "^9.39.4",
        "eslint-plugin-testing-library": "^7.16.2",
        "jsdom": "^30.1.1",
        "lint-staged": "^17.5.1",
        "openapi-typescript": "^7.13.0",
        "postcss-styled-jsx": "^1.0.1",
        "prettier": "^3.9.6",
        "resize-observer-polyfill": "^1.5.1",
        "stylelint": "^17.15.0",
        "stylelint-use-logical": "^2.1.3",
        "typescript": "^6",
        "typescript-plugin-css-modules": "^5.2.0",
        "vite": "^8.3.0",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@dhis2/app-runtime": "^3.17.4",
        "@dhis2/ui": "^10.17.0",
        "@reduxjs/toolkit": "^2.11.2",
        "loglevel": "^1.9.2",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "react-redux": "^9.2.0"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": [
            "eslint",
            "prettier --check"
        ],
        "*.{css,scss,tsx}": [
            "stylelint --max-warnings=0"
        ],
        "*.{css,scss,json,md,MD,yml,YML,yaml,YAML}": [
            "prettier --check"
        ]
    },
    "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
